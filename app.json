{
  "expo": {
    "name": "Vuna Transport",
    "slug": "vuna-transport-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F5"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061735",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.vunatransportmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vuna-transport",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Vuna Transport to capture delivery evidence."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vuna Transport to scan setup QR codes."
        }
      ]
    ]
  }
}
