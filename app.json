{
  "expo": {
    "name": "Vuna Transport",
    "slug": "vuna-transport-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061735",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.vunatransportmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "vuna-transport",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Vuna Transport to capture delivery evidence."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vuna Transport to scan setup QR codes."
        }
      ],
      "expo-notifications",
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Vuna Transport to show your position relative to delivery stops."
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a2aac36-8e28-4291-acc1-c3870cdea239"
      }
    },
    "owner": "emmanuelmwendwa"
  }
}
